# Backend Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=*

# Database Connection (Leave empty for SQLite local default, or provide PostgreSQL URL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/screening_db
DATABASE_URL=sqlite:///./screening_authority.db

# Frontend (Vite) API Target
# On Render production, set this to your Render Backend Service URL:
# Example: https://sih-document-screening-api.onrender.com
VITE_API_URL=http://localhost:8000
